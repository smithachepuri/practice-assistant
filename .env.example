# Copy this file to .env.local and fill in the key for the provider you use.
# .env.local is ignored by git; never commit real keys.

# Which model provider to use: openai or anthropic
ASSISTANT_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the default model for each provider.
# OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: send requests through a gateway or proxy instead of the public API.
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
